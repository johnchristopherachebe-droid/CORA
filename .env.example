# Copy to .env for local testing. In Vercel, add these under Settings -> Environment Variables.
# NEVER commit the real .env file.

# --- Required in the cloud ---
DATABASE_URL=
CORA_ACCESS_PASSWORD=choose-a-long-unique-password-16+-chars
# NEW: a separate random secret (32+ chars) that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- AI providers (add at least one) ---
AI_BRAIN_ORDER=gemini,groq,cerebras,openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional ---
CORA_TIMEZONE=Europe/London
CORA_DIGEST_TOPICS=
CRON_SECRET=
FISH_API_KEY=
FISH_VOICE_ID=
